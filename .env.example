# All values have defaults; no .env is required for `docker compose up`.
DATABASE_URL=postgresql://certiflow:certiflow@localhost:5432/certiflow
TEST_DATABASE_URL=postgresql://certiflow:certiflow@localhost:5432/certiflow_test
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
QUALITY_THRESHOLD=50
SLA_MINUTES=2
PUBLIC_BASE_URL=http://localhost:8080
DOWNLOAD_TOKEN_SECRET=dev-download-secret-change-me
# flaky (25% fail, 10% accepted-but-slow) | healthy | down
WHATSAPP_MODE=flaky
PUBLIC_RATE_LIMIT=60
PORT=4000
LOG_LEVEL=info
